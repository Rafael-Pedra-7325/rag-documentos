# Copie para .env e ajuste. Nenhuma variável é obrigatória.

# --- LLM (gera a resposta final) ---------------------------------------------
# Se vazio, o provedor é escolhido pela chave disponível:
# ANTHROPIC_API_KEY -> anthropic | OPENAI_API_KEY -> openai | nenhuma -> extractive
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Para Ollama/LM Studio/vLLM use o provedor "openai" com a URL do servidor local:
# OPENAI_BASE_URL=http://localhost:11434/v1

# --- Embeddings e banco vetorial ---------------------------------------------
# sentence-transformers (neural, local) ou hashing (offline, sem downloads)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# chroma (ChromaDB persistente) ou numpy (busca exata, sem dependências extras)
VECTOR_STORE=chroma

# --- Indexação e busca --------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
# Descarta trechos com similaridade abaixo deste valor (0 = desligado)
MIN_SCORE=0.0
MAX_UPLOAD_MB=25

# --- Armazenamento ------------------------------------------------------------
DATA_DIR=data
